DATABASE_URL="postgresql://lcp:lcp@localhost:5432/lcp?schema=public"
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
PORT=3000
CORS_ORIGINS=http://localhost:5173
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# Optional, all have sane defaults:
# MAX_COMPANY_STORAGE_MB=500       # document storage quota per company
# PENDING_AFTER_DAY=3              # grace day of the month before "attendance/payroll still open" notifications fire
# DISABLE_SCHEDULER=true           # turn off the in-process notification sweep timer (e.g. if driving it from an external scheduler instead)
